
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read/write access to all folders to ensure "product images" (with space) 
    // and "product-images" (with dash) both work perfectly.
    match /{allPaths=**} {
      allow write: if true;
      allow read: if true;
    }
  }
}
