
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Represents an electrical or plumbing product available in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "long_description": { "type": "string" },
        "price": { "type": "number" },
        "old_price": { "type": "number" },
        "category": { "type": "string" },
        "image_urls": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "barcode": { "type": "string" },
        "is_featured": { "type": "boolean" },
        "unit": { "type": "string" },
        "stock_count": { "type": "number", "description": "Current number of items in inventory" }
      },
      "required": ["name", "price", "category"]
    },
    "UserSelfie": {
      "title": "UserSelfie",
      "description": "An image captured by a user for AI-powered visual search purposes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image_url": { "type": "string", "format": "uri" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["image_url", "created_at"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review for a product or the company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author_name": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "review_type": { "type": "string", "enum": ["homepage", "product"] },
        "product_id": { "type": "string", "format": "uuid" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["author_name", "rating", "comment", "review_type"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "User profile with role-based permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "full_name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar_url": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["admin", "staff", "user"] },
        "last_active": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google", "facebook", "password", "anonymous"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Publicly readable collection of all shop products."
    },
    "/user_selfies/{selfieId}": {
      "schema": { "$ref": "#/backend/entities/UserSelfie" },
      "description": "Admin-viewable images uploaded via visual search."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/backend/entities/Review" },
      "description": "Unified reviews table for storefront feedback and product reviews."
    },
    "/profiles/{userId}": {
      "schema": { "$ref": "#/backend/entities/AppUser" },
      "description": "User profiles and role management."
    }
  }
}
