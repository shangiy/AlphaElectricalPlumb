
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Represents an electrical or plumbing product available in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "longDescription": { "type": "string" },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "category": { "type": "string" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "barcode": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "unit": { "type": "string" },
        "stockCount": { "type": "number", "description": "Current number of items in inventory" }
      },
      "required": ["name", "price", "category", "imageUrls"]
    },
    "UserSelfie": {
      "title": "UserSelfie",
      "description": "An image captured by a user for AI-powered visual search purposes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review for the company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userName", "rating", "comment", "createdAt"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "User profile with role-based permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["admin", "staff", "user"] },
        "lastActive": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google", "facebook", "password", "anonymous"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Publicly readable collection of all shop products."
    },
    "/userSelfies/{selfieId}": {
      "schema": { "$ref": "#/backend/entities/UserSelfie" },
      "description": "Admin-viewable images uploaded via visual search."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/backend/entities/Review" },
      "description": "Publicly readable and writable collection of customer reviews."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/AppUser" },
      "description": "User profiles and role management."
    }
  }
}
